# Copy to .env in this folder:  copy .env.example .env

# --- Required ---
LLM_API_KEY=your_openai_api_key_here

# Data pipeline (run_*.py): Google Places API (New) and the Gemini API (stage 4 and the scheduler)
GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=

# Any long random text: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
GUARDRAIL_TOKEN_SECRET=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foodsight
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Neo4j runs in Neo4j Desktop on your own machine (instance FoodSight); start it there first.
# Use the password you set for that instance. The backend container overrides NEO4J_URI itself.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Optional: leave empty to skip ---
# Email links (Gmail: use an App password). Empty = links are printed in the backend log.
SMTP_USER=
SMTP_PASSWORD=
# Google login. Redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Admin review page: the pipeline's data/ and src/reference/ folders. Docker Compose sets both for
# the backend container; leave empty when the backend runs from backend/ on this machine.
PIPELINE_DATA_DIR=
PIPELINE_REFERENCE_DIR=

# --- Frontend (sent to the browser: no secrets here) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Optional ArcGIS Location Platform key (restrict it to your domains). Empty uses keyless grey and satellite tiles.
VITE_ARCGIS_API_KEY=

# --- Chatbot ---
LLM_API_STYLE=responses
LLM_API_URL=https://api.openai.com/v1/responses
LLM_QUERY_MODEL=gpt-5-mini
LLM_RESPONSE_MODEL=gpt-5-mini
LLM_QUERY_REASONING_EFFORT=minimal
LLM_RESPONSE_REASONING_EFFORT=minimal
# Max seconds per answer
RESPONSE_BUDGET_SECONDS=14
NEO4J_EXECUTE_QUERIES=true
# Print each pipeline step in the backend log
KG_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
# Seconds a repeated question reuses the query, the database rows and the answer (0 = off, e.g. while reloading data)
LLM_QUERY_CACHE_TTL_SECONDS=1800
NEO4J_CACHE_TTL_SECONDS=300
LLM_ANSWER_CACHE_TTL_SECONDS=600
# Chat messages one user may send per minute and per day (0 = no limit); each message costs LLM calls
CHAT_LIMIT_PER_MINUTE=10
CHAT_LIMIT_PER_DAY=200
