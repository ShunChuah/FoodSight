GOOGLE_PLACES_API_KEY=
GEMINI_API_KEY=

# Postgres on your own machine. The backend container overrides DB_HOST itself.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foodsight
DB_USER=postgres
DB_PASSWORD=

# Neo4j knowledge graph. Runs in Neo4j Desktop on your own machine; start the
# instance there before running run_graph.py.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

VITE_API_BASE_URL=http://localhost:8000/api/v1

# Signs email links and Google login state. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Email sending (verification and password reset). For Gmail: turn on 2-Step
# Verification, create an "App password", and use it as SMTP_PASSWORD.
# If these are empty, the links are printed in the backend log instead.
SMTP_USER=
SMTP_PASSWORD=

# Google login. Create an OAuth "Web application" client in Google Cloud Console
# with redirect URI http://localhost:8000/api/v1/auth/google/callback
# If these are empty, the Google button reports that it is not set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Leave these commented out for local development; the defaults work.
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:5173
# COOKIE_SECURE=false        # set true only when served over HTTPS
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# MAIL_FROM=                 # defaults to SMTP_USER
