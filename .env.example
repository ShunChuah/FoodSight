# Copy to .env in this folder:  copy .env.example .env

# --- Required ---
LLM_API_KEY=your_openai_api_key_here

# Any long random text: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
GUARDRAIL_TOKEN_SECRET=

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foodsight
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Neo4j (password must match docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=foodsight123
NEO4J_DATABASE=neo4j

# --- Optional: leave empty to skip ---
# Email links (Gmail: use an App password). Empty = links are printed in the backend log.
SMTP_USER=
SMTP_PASSWORD=
# Google login. Redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Frontend (sent to the browser: no secrets here) ---
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Chatbot ---
LLM_API_STYLE=responses
LLM_API_URL=https://api.openai.com/v1/responses
LLM_QUERY_MODEL=gpt-5-mini
LLM_RESPONSE_MODEL=gpt-5-mini
LLM_QUERY_REASONING_EFFORT=minimal
LLM_RESPONSE_REASONING_EFFORT=minimal
# Max seconds per answer
RESPONSE_BUDGET_SECONDS=14
NEO4J_EXECUTE_QUERIES=true
# Print each pipeline step in the backend log
KG_DEBUG=true
APP_TIMEZONE=Asia/Kuala_Lumpur
