VITE_API_URL=http://localhost:8000

# Optional basemap provider. Restart Vite after changing these values.
# Keep the provider's required attribution. Do not put private service keys here.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
