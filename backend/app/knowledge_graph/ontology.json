          "type": "STRING",
          "pg_type": "character varying(50)",
          "nullable": true
        },
        "wednesday": {
          "type": "STRING",
          "pg_type": "character varying(50)",
          "nullable": true
        },
        "thursday": {
          "type": "STRING",
          "pg_type": "character varying(50)",
          "nullable": true
        },
        "friday": {
          "type": "STRING",
          "pg_type": "character varying(50)",
          "nullable": true
        },
