    "Review": {
      "description": "One customer review.",
      "table": "review",
      "key": "review_id",
      "required": [],
      "indexes": [],
      "properties": {
        "review_id": {
          "type": "INTEGER",
          "pg_type": "integer",
          "nullable": false,
          "unique": true,
          "default": "nextval('review_review_id_seq'::regclass)"
        },
        "author_name": {
          "type": "STRING",
