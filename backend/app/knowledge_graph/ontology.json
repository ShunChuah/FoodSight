          "type": "STRING",
          "pg_type": "character varying(20)",
          "nullable": true,
          "vocabulary": "review.sentiment"
        },
        "published_at": {
          "type": "DATETIME",
          "pg_type": "timestamp with time zone",
          "nullable": true
        }
      },
      "postgres_only_columns": {
        "restaurant_id": {
          "pg_type": "integer",
          "nullable": false,
          "note": "Foreign key. Loaded into the graph as the HAS_REVIEW relationship, not as a property."
        }
      },
      "postgres_constraints": [
        "PRIMARY KEY (review_id)",
        "FOREIGN KEY (restaurant_id) REFERENCES restaurant(restaurant_id) ON DELETE CASCADE",
        "CHECK (((individual_rating IS NULL) OR ((individual_rating >= 1) AND (individual_rating <= 5))))",
        "CHECK (((sentiment IS NULL) OR ((sentiment)::text = ANY ((ARRAY['positive'::character varying, 'mixed'::character varying, 'neutral'::character varying, 'negative'::character varying])::text[]))))",
        "CREATE INDEX idx_review_restaurant ON public.review USING btree (restaurant_id)",
        "CREATE INDEX idx_review_sentiment ON public.review USING btree (sentiment)"
      ]
    }
  },
  "relationships": {
    "LOCATED_IN": {
      "pattern": "(:Restaurant)-[:LOCATED_IN]->(:Location)",
      "cardinality": "exactly 1",
      "from": "Restaurant",
      "to": "Location",
      "table": "restaurant",
      "from_column": "restaurant_id",
      "to_column": "location_id",
      "description": "Where the restaurant is: its map pin (latitude, longitude) and address. Made from restaurant.location_id."
    },
    "IN_AREA": {
      "pattern": "(:Location)-[:IN_AREA]->(:Area)",
      "cardinality": "0 or 1",
      "from": "Location",
      "to": "Area",
      "table": "location",
      "from_column": "location_id",
      "to_column": "area_id",
      "description": "The PJ section (for example SS 2 or PJU 6) that the pin falls inside. Made from location.area_id; a location with no area gets no link. Restaurant to area is two steps: (Restaurant)-[:LOCATED_IN]->(Location)-[:IN_AREA]->(Area)."
    },
    "IN_CITY": {
      "pattern": "(:Area)-[:IN_CITY]->(:City)",
      "cardinality": "exactly 1",
      "from": "Area",
      "to": "City",
      "table": "area",
      "from_column": "area_id",
      "to_column": "city_id",
      "description": "The city the section belongs to (Petaling Jaya). Made from area.city_id."
    },
    "IN_CLUSTER": {
      "pattern": "(:Restaurant)-[:IN_CLUSTER]->(:Cluster)",
      "cardinality": "0 or 1",
      "from": "Restaurant",
      "to": "Cluster",
      "table": "restaurant",
      "from_column": "restaurant_id",
      "to_column": "cluster_id",
      "description": "The group of nearby restaurants this one belongs to. Made from restaurant.cluster_id. Empty until the cluster table has data."
    },
    "SERVES": {
      "pattern": "(:Restaurant)-[:SERVES]->(:Cuisine)",
      "cardinality": "0 to 3",
      "from": "Restaurant",
      "to": "Cuisine",
      "table": "restaurant_cuisine",
      "from_column": "restaurant_id",
      "to_column": "cuisine_id",
      "description": "A cuisine the restaurant serves, for example Chinese (Malaysia) or Japanese. A restaurant can serve several. Made from the junction table restaurant_cuisine, one row per restaurant and cuisine pair."
    },
    "HAS_FACILITY": {
      "pattern": "(:Restaurant)-[:HAS_FACILITY]->(:Facility)",
      "cardinality": "0 or more",
      "from": "Restaurant",
      "to": "Facility",
      "table": "restaurant_facility",
      "from_column": "restaurant_id",
      "to_column": "facility_id",
      "description": "A service or feature the restaurant offers, for example Dine-in, Delivery or Wheelchair Accessible. A restaurant can have several. Made from the junction table restaurant_facility, one row per restaurant and facility pair."
    },
    "HAS_HOURS": {
      "pattern": "(:Restaurant)-[:HAS_HOURS]->(:OperatingHours)",
      "cardinality": "0 or 1",
      "from": "Restaurant",
      "to": "OperatingHours",
      "table": "operating_hours",
      "from_column": "restaurant_id",
      "to_column": "operating_hours_id",
      "description": "The restaurant's opening hours for each day of the week. At most one per restaurant. Made from operating_hours.restaurant_id."
    },
    "PRICED_AT": {
      "pattern": "(:Restaurant)-[:PRICED_AT]->(:PriceRange)",
      "cardinality": "0 or 1",
      "from": "Restaurant",
      "to": "PriceRange",
      "table": "price_range",
      "from_column": "restaurant_id",
      "to_column": "price_range_id",
      "description": "How expensive the restaurant is: the average meal price and its tier (budget, mid, upscale or luxury). At most one per restaurant. Made from price_range.restaurant_id."
    },
    "HAS_PROFILE": {
      "pattern": "(:Restaurant)-[:HAS_PROFILE]->(:BusinessProfile)",
      "cardinality": "0 or 1",
      "from": "Restaurant",
      "to": "BusinessProfile",
      "table": "business_profile",
      "from_column": "restaurant_id",
      "to_column": "profile_id",
      "description": "The AI-written business profile: halal status, target customers, service style, business style, ambiance and restaurant type. At most one per restaurant. Made from business_profile.restaurant_id."
    },
    "HAS_RATING": {
      "pattern": "(:Restaurant)-[:HAS_RATING]->(:Rating)",
      "cardinality": "0 or 1",
      "from": "Restaurant",
      "to": "Rating",
      "table": "rating",
      "from_column": "restaurant_id",
      "to_column": "rating_id",
      "description": "The restaurant's Google star rating and total number of reviews, with the time it was collected. Made from rating.restaurant_id."
    },
    "HAS_DISH": {
      "pattern": "(:Restaurant)-[:HAS_DISH]->(:Dish)",
      "cardinality": "0 or more",
      "from": "Restaurant",
      "to": "Dish",
      "table": "dish",
      "from_column": "restaurant_id",
      "to_column": "dish_id",
      "description": "A dish on the restaurant's menu, with its price and whether it is a signature dish. A restaurant can have many. Made from dish.restaurant_id. Empty until the dish table has data."
    },
    "HAS_REVIEW": {
      "pattern": "(:Restaurant)-[:HAS_REVIEW]->(:Review)",
      "cardinality": "0 or more",
      "from": "Restaurant",
      "to": "Review",
      "table": "review",
      "from_column": "restaurant_id",
      "to_column": "review_id",
      "description": "A single customer review of the restaurant: its text, star rating and sentiment. A restaurant can have many. Made from review.restaurant_id."
    },
    "COMPETES_WITH": {
      "pattern": "(:Restaurant)-[:COMPETES_WITH]-(:Restaurant)",
      "cardinality": "0 or more",
      "from": "Restaurant",
      "to": "Restaurant",
      "rule": "competes_with",
      "description": "Two OPERATIONAL restaurants in the same area that share at least one cuisine and have the same price tier. Not from a column: worked out by the competes_with rule in extract_relationships.py and rebuilt on every run. Stored once per pair, so query it without a direction: (a)-[:COMPETES_WITH]-(b)."
    }
  },
  "business_definitions": {
    "_note": "Placeholder thresholds. Replace them with FoodSight's own definitions.",
    "active restaurant": "business_status = 'OPERATIONAL'",
    "competitors of X": "(x)-[:COMPETES_WITH]-(c)",
    "density of an area": "count(DISTINCT active restaurants) in the area",
    "near / nearby": "point.distance between Location pins, within $default_radius_m (see Defaults)."
  },
  "query_expansions": {
    "Chinese": {
      "property": "Cuisine.name",
      "any_of": [
        "Chinese (Malaysia)",
        "Chinese (China)",
        "Chinese (Hong Kong)",
        "Chinese (Taiwan)"
      ]
    },
    "Western": {
      "property": "Cuisine.category",
      "any_of": [
        "Western"
      ]
    }
  },
  "cypher_rules": [
    "Read-only. Use only MATCH, OPTIONAL MATCH, WITH, WHERE, UNWIND, RETURN, ORDER BY, LIMIT.",
    "Use only the labels, relationship types and properties defined above, in the direction shown.",
    "Use only vocabulary values in filters. Map the user's words to them with the definitions and includes provided.",
    "Put user-supplied text and numbers in $parameters. Output {\"cypher\": \"...\", \"params\": {...}}.",
    "Use MATCH for what the user filters on and OPTIONAL MATCH for anything you only display.",
    "When listing restaurants, return restaurant_id, name, latitude and longitude, with LIMIT 20 or less.",
    "Use count(DISTINCT r) whenever a restaurant can match through several nodes.",
    "Halal, dietary and accessibility requirements are exact: never swap in a similar value.",
    "If the question needs data that is not here (for example foot traffic or sales), output {\"cypher\": null, \"reason\": \"...\"}."
  ],
