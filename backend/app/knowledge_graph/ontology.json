{
  "description": "FoodSight domain ontology. Defines every node type and relationship type allowed in the Neo4j knowledge graph. 'required' mirrors the NOT NULL columns in PostgreSQL.",
  "prompt_usage": "FoodSight graph ontology for schema-aware Cypher generation. Describes the shape of the Neo4j graph: labels, properties, types, relationships and Cypher rules. Allowed values of categorical properties are not copied here: each 'vocabulary' names a column in categories.json, and the prompt builder fills in its values, definitions and rules.",
  "vocabulary_source": "categories.json",
  "source_schema": "tables.md (generated by python db/dump_schema.py from the live PostgreSQL database)",
  "meta": {
    "domain": "Food and drink outlets in Petaling Jaya (PJ), Selangor, Malaysia. Each Restaurant node is one branch, not a brand.",
    "currency": "MYR",
    "timezone": "Asia/Kuala_Lumpur",
    "missing_means_unknown": "A missing relationship or a null property means UNKNOWN, not 'no'. A restaurant with no HAS_FACILITY link to Delivery may still deliver.",
    "matching": "Properties with a vocabulary hold its exact values: compare with = or IN. Properties marked match: fuzzy are free text: use toLower(x) CONTAINS toLower($param)."
  },
  "nodes": {
    "City": {
      "description": "Only one city: Petaling Jaya. Never filter on it.",
      "table": "city",
      "key": "city_id",
      "required": [
        "name",
        "state",
        "country"
      ],
      "indexes": [
        "name"
      ],
      "properties": {
        "city_id": {
          "type": "INTEGER",
          "pg_type": "integer",
          "nullable": false,
          "unique": true,
          "default": "nextval('city_city_id_seq'::regclass)"
        },
        "name": {
          "type": "STRING",
          "pg_type": "character varying(150)",
          "nullable": false
        },
        "state": {
          "type": "STRING",
          "pg_type": "character varying(100)",
          "nullable": false
        },
        "country": {
          "type": "STRING",
          "pg_type": "character varying(100)",
          "nullable": false
        }
      },
      "postgres_only_columns": {
        "boundary_geojson": {
          "pg_type": "text",
          "nullable": true,
          "note": "Not loaded into the graph: the graph ontology defines no property or relationship for it."
        }
      },
      "postgres_constraints": [
        "PRIMARY KEY (city_id)"
      ]
    },
    "Area": {
      "description": "One of PJ's official numbered sections. The name is the section code, then familiar places inside it in brackets, e.g. 'PJU 6 (Bandar Utama, Damansara Residensi)'.",
      "table": "area",
      "key": "area_id",
      "required": [
        "name",
        "type"
      ],
      "indexes": [
        "name"
      ],
      "properties": {
        "area_id": {
          "type": "INTEGER",
          "pg_type": "integer",
          "nullable": false,
          "unique": true,
          "default": "nextval('area_area_id_seq'::regclass)"
        },
        "name": {
          "type": "STRING",
          "pg_type": "character varying(250)",
          "nullable": false,
          "match": "fuzzy",
          "description": "For a section code, put a regular expression in a parameter and match a.name =~ $area_pattern. Allow an optional space and stop at the number: $area_pattern = '(?i)^SS ?2\\b.*' matches 'SS 2' but not 'SS 21'. For a place name use toLower(a.name) CONTAINS toLower($place)."
        },
        "type": {
          "type": "STRING",
          "pg_type": "character varying(50)",
          "nullable": false,
          "vocabulary": "area.type",
          "description": "Every area has the same type. Never filter on it."
        },
        "population_density": {
          "type": "FLOAT",
          "pg_type": "double precision",
          "nullable": true,
          "unit": "people per km²"
        }
      },
      "postgres_only_columns": {
        "city_id": {
          "pg_type": "integer",
          "nullable": false,
          "note": "Foreign key. Loaded into the graph as the IN_CITY relationship, not as a property."
        },
        "boundary_geojson": {
          "pg_type": "text",
          "nullable": true,
          "note": "Not loaded into the graph: the graph ontology defines no property or relationship for it."
        }
      },
      "postgres_constraints": [
        "PRIMARY KEY (area_id)",
        "FOREIGN KEY (city_id) REFERENCES city(city_id)"
      ]
    },
    "Location": {
      "description": "Map pin and address of one restaurant.",
      "table": "location",
      "key": "location_id",
      "required": [
        "latitude",
        "longitude"
      ],
      "indexes": [],
      "properties": {
        "location_id": {
          "type": "INTEGER",
          "pg_type": "integer",
          "nullable": false,
          "unique": true,
          "default": "nextval('location_location_id_seq'::regclass)"
        },
        "latitude": {
          "type": "FLOAT",
          "pg_type": "double precision",
          "nullable": false,
          "description": "WGS84 degrees"
        },
        "longitude": {
          "type": "FLOAT",
          "pg_type": "double precision",
          "nullable": false,
          "description": "WGS84 degrees"
        },
        "full_address": {
          "type": "STRING",
          "pg_type": "character varying(500)",
          "nullable": true,
          "match": "fuzzy"
        },
        "postcode": {
          "type": "STRING",
          "pg_type": "character varying(10)",
          "nullable": true,
          "description": "5 digits, e.g. '47300'. Compare with =."
        },
        "street": {
          "type": "STRING",
          "pg_type": "character varying(200)",
          "nullable": true,
          "match": "fuzzy"
        }
      },
      "postgres_only_columns": {
        "area_id": {
          "pg_type": "integer",
          "nullable": true,
          "note": "Foreign key. Loaded into the graph as the IN_AREA relationship, not as a property."
        }
      },
      "postgres_constraints": [
        "PRIMARY KEY (location_id)",
        "FOREIGN KEY (area_id) REFERENCES area(area_id)",
        "CREATE INDEX idx_location_postcode ON public.location USING btree (postcode)"
      ]
    },
    "Cluster": {
      "description": "A group of nearby restaurants.",
      "table": "cluster",
      "key": "cluster_id",
      "required": [
        "centroid_lat",
        "centroid_lon",
        "restaurant_count"
      ],
      "indexes": [],
      "properties": {
        "cluster_id": {
          "type": "INTEGER",
          "pg_type": "integer",
          "nullable": false,
          "unique": true,
          "default": "nextval('cluster_cluster_id_seq'::regclass)"
        },
        "centroid_lat": {
          "type": "FLOAT",
          "pg_type": "double precision",
          "nullable": false,
          "description": "WGS84 degrees"
        },
        "centroid_lon": {
          "type": "FLOAT",
          "pg_type": "double precision",
          "nullable": false,
          "description": "WGS84 degrees"
        },
        "restaurant_count": {
          "type": "INTEGER",
          "pg_type": "integer",
          "nullable": false,
          "default": "0",
          "range": "0 or more"
        },
        "density_score": {
          "type": "FLOAT",
          "pg_type": "double precision",
          "nullable": true
        }
      },
      "postgres_only_columns": {
        "area_id": {
          "pg_type": "integer",
          "nullable": true,
          "note": "Not loaded into the graph: the graph ontology defines no property or relationship for it."
        },
        "boundary_geojson": {
          "pg_type": "text",
          "nullable": true,
          "note": "Not loaded into the graph: the graph ontology defines no property or relationship for it."
        }
      },
      "postgres_constraints": [
        "PRIMARY KEY (cluster_id)",
        "FOREIGN KEY (area_id) REFERENCES area(area_id)",
        "CHECK ((restaurant_count >= 0))"
      ]
    },
    "Restaurant": {
      "description": "One food or drink outlet.",
      "table": "restaurant",
      "key": "restaurant_id",
      "required": [
        "name",
        "amenity_type",
        "business_status"
      ],
      "indexes": [
        "name",
        "osm_id"
      ],
      "properties": {
        "restaurant_id": {
          "type": "INTEGER",
          "pg_type": "integer",
          "nullable": false,
          "unique": true,
          "default": "nextval('restaurant_restaurant_id_seq'::regclass)",
          "description": "Primary key. Always return it."
        },
        "osm_id": {
          "type": "STRING",
          "pg_type": "character varying(50)",
          "nullable": true,
          "unique": true,
          "description": "OpenStreetMap ID. Never show it to users."
        },
        "name": {
          "type": "STRING",
          "pg_type": "character varying(255)",
          "nullable": false,
          "match": "fuzzy"
        },
        "amenity_type": {
          "type": "STRING",
          "pg_type": "character varying(50)",
          "nullable": false,
          "vocabulary": "restaurant.amenity_type",
          "description": "Broad OpenStreetMap venue type. For the type a local would say (kopitiam, mamak) use BusinessProfile.restaurant_type."
        },
        "brand": {
          "type": "STRING",
          "pg_type": "character varying(150)",
          "nullable": true,
          "match": "fuzzy",
          "description": "Chain name shared by branches."
        },
        "phone": {
          "type": "STRING",
          "pg_type": "character varying(50)",
          "nullable": true
        },
        "website": {
          "type": "STRING",
          "pg_type": "character varying(500)",
          "nullable": true
        },
        "business_status": {
          "type": "STRING",
          "pg_type": "character varying(50)",
          "nullable": false,
          "default": "'OPERATIONAL'::character varying",
          "vocabulary": "restaurant.business_status",
          "description": "Filter = 'OPERATIONAL' unless the user asks about closed places. Not the same as open right now."
        },
        "created_at": {
          "type": "DATETIME",
          "pg_type": "timestamp with time zone",
          "nullable": false,
          "default": "now()",
          "description": "When the database record was created, not when the restaurant opened. Do not use it for 'new restaurants'."
        },
        "updated_at": {
          "type": "DATETIME",
          "pg_type": "timestamp with time zone",
          "nullable": false,
          "default": "now()",
          "description": "When the database record last changed."
        }
      },
      "postgres_only_columns": {
        "location_id": {
          "pg_type": "integer",
          "nullable": false,
          "note": "Foreign key. Loaded into the graph as the LOCATED_IN relationship, not as a property."
        },
        "cluster_id": {
          "pg_type": "integer",
          "nullable": true,
          "note": "Foreign key. Loaded into the graph as the IN_CLUSTER relationship, not as a property."
        }
      },
      "postgres_constraints": [
        "PRIMARY KEY (restaurant_id)",
        "UNIQUE (osm_id)",
        "FOREIGN KEY (cluster_id) REFERENCES cluster(cluster_id)",
        "FOREIGN KEY (location_id) REFERENCES location(location_id)",
        "CHECK (((business_status)::text = ANY ((ARRAY['OPERATIONAL'::character varying, 'CLOSED_TEMPORARILY'::character varying, 'PERMANENTLY_CLOSED'::character varying])::text[])))",
        "CREATE INDEX idx_restaurant_amenity ON public.restaurant USING btree (amenity_type)",
        "CREATE INDEX idx_restaurant_osm ON public.restaurant USING btree (osm_id)"
      ]
    },
    "Cuisine": {
      "description": "A food tradition or main product. A restaurant can serve up to 3, so count DISTINCT restaurants.",
      "table": "cuisine",
      "key": "cuisine_id",
      "required": [
        "name"
      ],
      "indexes": [
        "name"
      ],
      "properties": {
        "cuisine_id": {
          "type": "INTEGER",
          "pg_type": "integer",
          "nullable": false,
          "unique": true,
          "default": "nextval('cuisine_cuisine_id_seq'::regclass)"
        },
        "name": {
          "type": "STRING",
          "pg_type": "character varying(100)",
          "nullable": false,
          "unique": true,
          "vocabulary": "cuisine.name"
        },
        "origin_country": {
          "type": "STRING",
          "pg_type": "character varying(100)",
          "nullable": true,
          "description": "Taxonomy metadata only. Never filter on it."
        },
        "category": {
          "type": "STRING",
          "pg_type": "character varying(50)",
          "nullable": true,
          "vocabulary": "cuisine.category"
        }
      },
      "postgres_constraints": [
        "PRIMARY KEY (cuisine_id)",
        "UNIQUE (name)"
      ]
    },
    "Facility": {
      "description": "A service or feature the restaurant offers, as reported by Google.",
      "table": "facility",
      "key": "facility_id",
      "required": [
        "name",
        "category"
      ],
      "indexes": [
        "name"
      ],
      "properties": {
        "facility_id": {
          "type": "INTEGER",
          "pg_type": "integer",
          "nullable": false,
          "unique": true,
          "default": "nextval('facility_facility_id_seq'::regclass)"
        },
        "name": {
          "type": "STRING",
          "pg_type": "character varying(100)",
          "nullable": false,
          "unique": true,
          "vocabulary": "facility.name"
        },
        "category": {
          "type": "STRING",
          "pg_type": "character varying(50)",
          "nullable": false,
          "vocabulary": "facility.category"
        }
      },
      "postgres_constraints": [
        "PRIMARY KEY (facility_id)",
        "UNIQUE (name)"
      ]
    },
    "Dish": {
      "description": "A dish on a restaurant's menu.",
      "table": "dish",
      "key": "dish_id",
      "required": [
        "name",
        "is_signature"
      ],
      "indexes": [
        "name"
      ],
      "properties": {
        "dish_id": {
          "type": "INTEGER",
          "pg_type": "integer",
          "nullable": false,
          "unique": true,
          "default": "nextval('dish_dish_id_seq'::regclass)"
        },
        "name": {
          "type": "STRING",
          "pg_type": "character varying(200)",
          "nullable": false,
          "match": "fuzzy"
        },
        "price": {
          "type": "FLOAT",
          "pg_type": "double precision",
          "nullable": true,
          "unit": "MYR",
          "range": "greater than 0"
        },
        "category": {
          "type": "STRING",
          "pg_type": "character varying(100)",
          "nullable": true
        },
        "is_signature": {
          "type": "BOOLEAN",
          "pg_type": "boolean",
          "nullable": false,
          "default": "false",
          "description": "True for the restaurant's signature dishes."
        }
      },
      "postgres_only_columns": {
        "restaurant_id": {
          "pg_type": "integer",
          "nullable": false,
          "note": "Foreign key. Loaded into the graph as the HAS_DISH relationship, not as a property."
        },
        "cuisine_id": {
          "pg_type": "integer",
          "nullable": true,
          "note": "Not loaded into the graph: the graph ontology defines no property or relationship for it."
        }
      },
      "postgres_constraints": [
        "PRIMARY KEY (dish_id)",
        "FOREIGN KEY (cuisine_id) REFERENCES cuisine(cuisine_id)",
        "FOREIGN KEY (restaurant_id) REFERENCES restaurant(restaurant_id) ON DELETE CASCADE",
        "CHECK (((price IS NULL) OR (price > (0)::double precision)))"
      ]
    },
    "PriceRange": {
      "description": "How expensive the restaurant is.",
      "table": "price_range",
      "key": "price_range_id",
      "required": [
        "tier"
      ],
      "indexes": [
        "tier"
      ],
      "properties": {
        "price_range_id": {
          "type": "INTEGER",
          "pg_type": "integer",
          "nullable": false,
          "unique": true,
          "default": "nextval('price_range_price_range_id_seq'::regclass)"
        },
        "tier": {
          "type": "STRING",
          "pg_type": "character varying(20)",
          "nullable": false,
          "vocabulary": "price_range.tier"
        },
        "avg_meal_price": {
          "type": "FLOAT",
          "pg_type": "double precision",
          "nullable": true,
          "unit": "MYR per person per meal",
          "description": "AI estimate. If the user gives an amount, filter on this, not on tier."
        }
      },
      "postgres_only_columns": {
        "restaurant_id": {
          "pg_type": "integer",
          "nullable": false,
          "note": "Foreign key. Loaded into the graph as the PRICED_AT relationship, not as a property."
        }
      },
      "postgres_constraints": [
        "PRIMARY KEY (price_range_id)",
        "UNIQUE (restaurant_id)",
        "FOREIGN KEY (restaurant_id) REFERENCES restaurant(restaurant_id) ON DELETE CASCADE",
        "CHECK (((tier)::text = ANY ((ARRAY['budget'::character varying, 'mid'::character varying, 'upscale'::character varying, 'luxury'::character varying])::text[])))"
      ]
    },
    "BusinessProfile": {
      "description": "AI-written profile. Say it is inferred when an answer relies on it.",
      "table": "business_profile",
      "key": "profile_id",
      "required": [
        "halal_status"
      ],
      "indexes": [
        "halal_status"
      ],
      "properties": {
        "profile_id": {
          "type": "INTEGER",
          "pg_type": "integer",
          "nullable": false,
          "unique": true,
          "default": "nextval('business_profile_profile_id_seq'::regclass)"
        },
        "halal_status": {
          "type": "STRING",
          "pg_type": "character varying(20)",
          "nullable": false,
          "vocabulary": "business_profile.halal_status",
          "description": "'unknown' is not 'non-halal'. A halal request filters = 'halal' only."
        },
        "target_segment": {
          "type": "STRING",
          "pg_type": "text",
          "nullable": true,
          "format": "comma and space separated, e.g. 'families, students'",
          "vocabulary": "business_profile.target_segment",
          "description": "Filter with 'students' IN split(bp.target_segment, ', ')."
        },
        "service_style": {
          "type": "STRING",
          "pg_type": "character varying(100)",
          "nullable": true,
          "vocabulary": "business_profile.service_style"
        },
        "business_style": {
          "type": "STRING",
          "pg_type": "character varying(100)",
          "nullable": true,
          "vocabulary": "business_profile.business_style"
        },
        "ambiance": {
          "type": "STRING",
          "pg_type": "character varying(100)",
          "nullable": true,
          "format": "comma and space separated, e.g. 'cosy, quiet'",
          "vocabulary": "business_profile.ambiance",
          "description": "Filter with 'quiet' IN split(bp.ambiance, ', ')."
        },
        "restaurant_type": {
          "type": "STRING",
          "pg_type": "character varying(100)",
          "nullable": true,
          "vocabulary": "business_profile.restaurant_type"
        },
        "generated_at": {
          "type": "DATETIME",
          "pg_type": "timestamp with time zone",
          "nullable": false,
          "default": "now()"
        }
      },
      "postgres_only_columns": {
        "restaurant_id": {
          "pg_type": "integer",
          "nullable": false,
          "note": "Foreign key. Loaded into the graph as the HAS_PROFILE relationship, not as a property."
        }
      },
      "postgres_constraints": [
        "PRIMARY KEY (profile_id)",
        "UNIQUE (restaurant_id)",
        "FOREIGN KEY (restaurant_id) REFERENCES restaurant(restaurant_id) ON DELETE CASCADE",
        "CHECK (((halal_status)::text = ANY ((ARRAY['halal'::character varying, 'non-halal'::character varying, 'unknown'::character varying])::text[])))"
      ]
    },
