# Copy this file to backend/.env and fill in the values. Restart the backend after changes.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_TIMEZONE=Asia/Kuala_Lumpur
GUARDRAIL_TOKEN_SECRET=replace_with_a_long_random_secret

# ---------------------------------------------------------------------------
# PostgreSQL (chat and login tables)
# Runs on your own machine. Docker sets DB_HOST to host.docker.internal itself.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=foodsight
DB_USER=postgres
DB_PASSWORD=your_postgres_password
# Optional: a full URL for the chat tables instead of the DB_* settings above.
# DATABASE_URL=postgresql+psycopg2://postgres:your_postgres_password@localhost:5432/foodsight

# ---------------------------------------------------------------------------
# Login
# ---------------------------------------------------------------------------
# Signs email links and Google login state. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
# Email sending (verification and password reset). For Gmail, use an App password.
# If these are empty, the links are printed in the backend log instead.
SMTP_USER=
SMTP_PASSWORD=
# Google login (redirect URI http://localhost:8000/api/v1/auth/google/callback).
# If these are empty, the Google button reports that it is not set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; the defaults work for local development.
# FRONTEND_URL=http://localhost:5173
# BACKEND_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:5173
# COOKIE_SECURE=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# MAIL_FROM=

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# Styles: content, responses, or chat.
LLM_API_STYLE=responses
LLM_API_URL=https://api.openai.com/v1/responses
LLM_API_KEY=your_openai_api_key_here
# Fallback model when a task model below is not set.
# LLM_MODEL=gpt-5.4

# Cypher generation
LLM_QUERY_MODEL=gpt-5-mini
LLM_QUERY_TIMEOUT_SECONDS=15
LLM_QUERY_REASONING_EFFORT=minimal
LLM_QUERY_MAX_OUTPUT_TOKENS=1024
LLM_QUERY_JSON_MODE=true
# Set false for providers that do not support strict JSON Schema output.
LLM_QUERY_STRUCTURED_OUTPUTS=true

# Answer generation
LLM_RESPONSE_MODEL=gpt-5-mini
LLM_RESPONSE_TIMEOUT_SECONDS=15
# "Thinking" time: minimal is fastest (gpt-5 family only).
LLM_RESPONSE_REASONING_EFFORT=minimal
# Ask for a JSON object. Set false if your provider rejects JSON mode.
LLM_RESPONSE_JSON_MODE=true
# The answer is ready within this many seconds (a written-out answer is used when time runs short).
RESPONSE_BUDGET_SECONDS=13.5

# ---------------------------------------------------------------------------
# Neo4j knowledge graph
# Docker sets NEO4J_URI to bolt://neo4j:7687 itself.
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=foodsight123
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_SECONDS=10
# Set false to generate and validate Cypher without running it.
NEO4J_EXECUTE_QUERIES=true
# Print each Cypher and knowledge-graph pipeline stage in backend logs.
KG_DEBUG=true

# Graph files (relative paths resolve from backend; restart after edits).
# The ontology's vocabulary_source (categories.json) and the examples file are read from its folder.
QUERY_ASSUMPTIONS_PATH=app/knowledge_graph/query_assumptions.json
ONTOLOGY_PATH=app/knowledge_graph/ontology.json
CYPHER_EXAMPLES_FILE=cypher_examples.json
