DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/foodsight
APP_TIMEZONE=Asia/Kuala_Lumpur
GUARDRAIL_TOKEN_SECRET=replace_with_a_long_random_secret

# LLM settings
# Styles: content, responses, or chat.
LLM_API_STYLE=responses
LLM_API_URL=https://api.openai.com/v1/responses
LLM_API_KEY=your_openai_api_key_here
# Task-specific model routing
LLM_QUERY_MODEL=gpt-5-mini
LLM_RESPONSE_MODEL=gpt-5-mini
# Answer model "thinking" time: minimal is fastest (gpt-5 family only).
LLM_RESPONSE_REASONING_EFFORT=minimal
LLM_QUERY_TIMEOUT_SECONDS=15
LLM_QUERY_REASONING_EFFORT=minimal
LLM_QUERY_MAX_OUTPUT_TOKENS=1024
LLM_QUERY_JSON_MODE=true
# Set false for providers that do not support strict JSON Schema output.
LLM_QUERY_STRUCTURED_OUTPUTS=true
LLM_RESPONSE_TIMEOUT_SECONDS=15
# Ask the answer model for a JSON object. Set false if your provider rejects JSON mode.
LLM_RESPONSE_JSON_MODE=true
# Optional backward-compatible fallback when a task model is not set.
# LLM_MODEL=gpt-5.4

# Neo4j knowledge graph settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=foodsight123
NEO4J_DATABASE=neo4j
NEO4J_QUERY_TIMEOUT_SECONDS=10
QUERY_ASSUMPTIONS_PATH=app/knowledge_graph/query_assumptions.json
# Graph ontology for the Cypher prompt (relative paths resolve from backend; restart after edits). Its vocabulary_source
# (categories.json) and the examples file are read from the same folder.
ONTOLOGY_PATH=app/knowledge_graph/ontology.json
CYPHER_EXAMPLES_FILE=cypher_examples.json
# The answer is ready within this many seconds (a written-out answer is used when time runs short).
RESPONSE_BUDGET_SECONDS=13.5
# Print each Cypher and knowledge-graph pipeline stage in backend logs.
KG_DEBUG=true
# Set false to generate and validate Cypher without running it.
NEO4J_EXECUTE_QUERIES=true
